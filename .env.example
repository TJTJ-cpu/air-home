# --- Webcam ---
CAMERA_INDEX=0
# Frames discarded before the keeper, so auto-exposure/focus can settle.
CAMERA_WARMUP_FRAMES=8
# Ask the webcam for this resolution. Leave blank to use its default.
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# --- LM Studio (OpenAI-compatible local server) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3-vl-8b
# Images are downscaled to this width before being sent to the model.
VISION_MAX_WIDTH=1280

# Plausible indoor temperature for your climate. A reading outside this is
# treated as a misread digit rather than data. Laos: 10-45 is generous.
TEMP_MIN_C=10
TEMP_MAX_C=45

# --- Analysis ---
# Readings are stored in UTC; reports are shown on this local clock.
LOCAL_UTC_OFFSET=7
# What counts as "night", on the local clock. Runs evening -> next morning,
# so a night is one continuous block rather than two half-days.
NIGHT_START_HOUR=20
NIGHT_END_HOUR=9
